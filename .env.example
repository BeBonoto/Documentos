# =============================================================================
# Organizador de Documentos — variáveis de ambiente
# cp .env.example .env   e preencha os valores marcados com <...>
# =============================================================================

# ---- Servidor ----
PORT=3000
LOG_LEVEL=info
# URL pela qual a Evolution API alcança este app (usada p/ baixar arquivos no driver local)
PUBLIC_BASE_URL=http://localhost:3000
# Token secreto exigido no webhook: /webhook/evolution?token=...  (gere com: openssl rand -hex 24)
WEBHOOK_TOKEN=<troque-por-um-token-aleatorio-longo>
# Telefones autorizados (DDI+DDD+número, separados por vírgula). Vazio = qualquer um.
ALLOWED_PHONES=
QUEUE_CONCURRENCY=3

# ---- Banco (Postgres + pgvector) ----
# Supabase: Settings > Database > Connection string (use DATABASE_SSL=true)
DATABASE_URL=postgresql://app:app@localhost:5432/docs
DATABASE_SSL=false

# ---- Evolution API (WhatsApp) ----
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<chave-global-da-evolution>
EVOLUTION_INSTANCE=docs-bot

# ---- OpenAI ----
OPENAI_API_KEY=<sk-...>
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ---- Storage ----
# local    -> disco + URL assinada servida pelo app (dev)
# supabase -> Supabase Storage (bucket PRIVADO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
FILE_URL_SECRET=<outro-segredo-aleatorio-longo>
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents
SIGNED_URL_TTL_SECONDS=600

# ---- Extração ----
OCR_LANG=por
OCR_MAX_PDF_PAGES=5
MAX_FILE_MB=15

# ---- Economia de tokens ----
# texto máximo enviado na classificação (início + fim)
CLASSIFY_MAX_CHARS=4000
# ~300 tokens por chunk
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# chunks por pergunta
RAG_TOP_K=4
# abaixo disso, responde "não encontrei" sem chamar o LLM
RAG_MIN_SIMILARITY=0.25
# teto de contexto (~900 tokens)
RAG_MAX_CONTEXT_CHARS=3500
RAG_MAX_OUTPUT_TOKENS=300
# usa LLM (1-3 tokens de saída) só p/ mensagens ambíguas
LLM_INTENT_FALLBACK=true

# ---- Lembretes ----
REMINDER_DAYS_BEFORE=3
REMINDER_HOUR=9
REMINDER_TZ=America/Sao_Paulo
REMINDER_POLL_SECONDS=60
