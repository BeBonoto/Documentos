{
  "name": "whatsapp-doc-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp que organiza documentos pessoais (armazenamento + RAG enxuto).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "mammoth": "^1.12.3",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
